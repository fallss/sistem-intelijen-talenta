# ============================================================
# Talent Match Intelligence System - Environment Configuration
# ============================================================
# Copy this file to .env and replace placeholder values with your real credentials.

# Database Configuration (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL=postgresql://<username>:<password>@<host>:6543/postgres

# OpenRouter API Key for LLM Insights (GPT-4o-mini, Claude, LLaMA)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google Gemini API Key (Optional Alternative)
GOOGLE_API_KEY=your_google_api_key_here

# Supabase REST Client Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key_here
